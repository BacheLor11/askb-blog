---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('essays');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data.pubDate;
const dateStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

// 无标题时取正文首句作为标题
function firstSentence(body) {
  if (!body) return '';
  const text = (body || '')
    .split('\n')
    .map((l) => l.trim())
    .filter((l) => l && !/^#+\s/.test(l) && !/^>\s?/.test(l) && !/^[-*]\s/.test(l) && !/^!\[/.test(l))
    .join(' ');
  const clean = text.replace(/[*_`#>]/g, '').trim();
  return clean.length > 50 ? clean.slice(0, 50) + '…' : clean;
}

const title = post.data.title || firstSentence(post.body) || dateStr;
const description = post.data.description || title;
---
<BaseLayout title={`${title} · askb.app`} description={description}>
  <article class="prose">
    <p class="meta">{dateStr}</p>
    <h1>{title}</h1>
    <Content />
  </article>
</BaseLayout>
