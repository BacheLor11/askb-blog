---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = (await getCollection('tools')).sort(
  (a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)
);
---
<BaseLayout title="工具 · ASKB">
  <section class="hero">
    <h1>工具</h1>
    <p class="lede">我常用的在线小工具集合，点击卡片直达。</p>
  </section>
  <div class="post-grid">
    {tools.map(tool => (
      <article class="card">
        <a href={tool.data.url} target="_blank" rel="noopener">
          <h3>{tool.data.title}</h3>
          {tool.data.description && <p class="desc">{tool.data.description}</p>}
          <p class="meta">{tool.data.url}</p>
        </a>
      </article>
    ))}
  </div>
</BaseLayout>
