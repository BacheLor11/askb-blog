---
const { post } = Astro.props;
// 按所属集合决定跳转前缀
const prefix =
  post.collection === 'resources' ? '/resources/'
  : post.collection === 'essays' ? '/essays/'
  : '/blog/';
const d = post.data.pubDate;
const dateStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

// 无标题时取正文首句作为标题
function firstSentence(body) {
  if (!body) return '';
  const text = (body || '')
    .split('\n')
    .map((l) => l.trim())
    .filter((l) => l && !/^#+\s/.test(l) && !/^>\s?/.test(l) && !/^[-*]\s/.test(l) && !/^!\[/.test(l))
    .join(' ');
  const clean = text.replace(/[*_`#>]/g, '').trim();
  return clean.length > 50 ? clean.slice(0, 50) + '…' : clean;
}

const title = post.data.title || firstSentence(post.body) || dateStr;
const desc = post.data.description || '';
---
<article class="card">
  <a href={`${prefix}${post.slug}/`}>
    <div class="meta">{dateStr}</div>
    <h3>{title}</h3>
    {desc && <p class="desc">{desc}</p>}
  </a>
</article>
