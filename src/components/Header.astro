---
const nav = [
  { href: '/', label: '首页' },
  { href: '/essays', label: '随笔' },
  { href: '/articles', label: '文章' },
  { href: '/resources', label: '资源' },
  { href: '/tools', label: '工具' },
  { href: '/about', label: '关于' },
  { href: '/rss.xml', label: 'RSS' },
];
---
<header class="site-header">
  <div class="inner">
    <a class="brand" href="/">ASKB</a>
    <div class="header-actions">
      <nav class="nav" id="primary-nav">
        {nav.map(item => <a href={item.href}>{item.label}</a>)}
      </nav>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="切换深色模式" title="切换深色模式">
        <svg class="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path class="i-moon" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          <g class="i-sun">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </g>
        </svg>
      </button>
      <button class="nav-toggle" aria-label="打开菜单" aria-expanded="false" aria-controls="primary-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const navEl = document.querySelector('.nav');
  const header = document.querySelector('.site-header');
  let lastScrollY = window.scrollY;

  function closeMenu() {
    if (!navEl) return;
    navEl.classList.remove('open');
    if (toggle) {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.classList.remove('active');
    }
  }

  if (toggle && navEl) {
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = navEl.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.classList.toggle('active', open);
    });
    // 点任意导航项后自动收起菜单
    navEl.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
    // 点击菜单栏以外的区域自动收起
    document.addEventListener('click', (e) => {
      if (!navEl.classList.contains('open')) return;
      if (navEl.contains(e.target) || toggle.contains(e.target)) return;
      closeMenu();
    });
    // 滚动时：菜单展开则收起；移动端导航栏自动隐藏/展示
    window.addEventListener('scroll', () => {
      if (navEl.classList.contains('open')) {
        closeMenu();
        return;
      }
      if (window.innerWidth > 640) return;
      const y = window.scrollY;
      if (y > lastScrollY && y > 80) {
        header.classList.add('hidden');
      } else {
        header.classList.remove('hidden');
      }
      lastScrollY = y;
    }, { passive: true });
  }

  // 深色模式切换：跟随系统或手动，偏好存入 localStorage（图标由 CSS 按 data-theme 自动切换）
  const themeToggle = document.getElementById('themeToggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const cur = document.documentElement.getAttribute('data-theme');
      const next = cur === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (err) {}
    });
  }
</script>
