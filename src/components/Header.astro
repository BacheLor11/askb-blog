---
const nav = [
  { href: '/', label: '首页' },
  { href: '/articles', label: '文章' },
  { href: '/resources', label: '资源' },
  { href: '/about', label: '关于' },
  { href: '/rss.xml', label: 'RSS' },
];
---
<header class="site-header">
  <div class="inner">
    <a class="brand" href="/">ASKB</a>
    <nav class="nav">
      {nav.map(item => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>
