---
import { render } from 'astro:content';

const { entry, months = [], current } = Astro.props;
const { Content } = await render(entry);

const title = entry.data.title || `大肥鱼带你刷知乎 · ${entry.data.month}`;
const count = entry.data.count;
const updated = entry.data.updated;

// 从正文里抓「## YYYY-MM-DD」日期段落，生成日期跳转条
const dates = (entry.body || '')
  .split('\n')
  .map((l) => l.trim())
  .filter((l) => /^##\s+\d{4}-\d{2}-\d{2}$/.test(l))
  .map((l) => l.replace(/^##\s+/, ''));

const wdCN = ['日', '一', '二', '三', '四', '五', '六'];
function monthLabel(m) {
  const p = m.split('-');
  return `${p[0]}年${Number(p[1])}月`;
}

const sorted = [...months].sort((a, b) => b.month.localeCompare(a.month));
const isLatest = sorted.length > 0 && sorted[0].month === current;
const others = sorted.filter((m) => m.month !== current);

// —— 月历：当月天数、1 号是周几、有内容的日期集合、前后月（只在已有月份的范围内切换）
const [cy, cm] = current.split('-').map(Number);
const daysInMonth = new Date(cy, cm, 0).getDate();
const firstWeekday = new Date(cy, cm - 1, 1).getDay(); // 0 = 周日
const haveDays = new Set(dates);
const curIdx = sorted.findIndex((m) => m.month === current);
const newerMonth = curIdx > 0 ? sorted[curIdx - 1].month : null; // 右箭头 → 更新的一期
const olderMonth = curIdx >= 0 && curIdx < sorted.length - 1 ? sorted[curIdx + 1].month : null;
const calendarDays = Array.from({ length: daysInMonth }, (_, i) => {
  const day = i + 1;
  const date = `${current}-${String(day).padStart(2, '0')}`;
  return { day, date, has: haveDays.has(date) };
});
---
<article class="zhihu">
  <header class="zh-head">
    <p class="kicker">大肥鱼带你刷知乎</p>
    <h1>{title}</h1>
    <p class="sub">
      {count ? <span>本月共 <strong>{count}</strong> 条</span> : null}
      {updated ? <span> · 更新于 {updated}</span> : null}
      {!isLatest ? <span> · <a href="/resources/zhihu-daily-picks/">← 返回最新</a></span> : null}
    </p>
  </header>

  {dates.length > 0 && (
    <nav class="cal" aria-label="按日期跳转">
      <div class="cal-head">
        {olderMonth ? (
          <a class="cal-nav" href={`/resources/zhihu-daily-picks/${olderMonth}/`} aria-label={`上一个月 ${monthLabel(olderMonth)}`}>‹</a>
        ) : (
          <span class="cal-nav is-off" aria-hidden="true">‹</span>
        )}
        <span class="cal-title">{cy} 年 {cm} 月</span>
        {newerMonth ? (
          <a class="cal-nav" href={`/resources/zhihu-daily-picks/${newerMonth}/`} aria-label={`下一个月 ${monthLabel(newerMonth)}`}>›</a>
        ) : (
          <span class="cal-nav is-off" aria-hidden="true">›</span>
        )}
      </div>
      <div class="cal-week">
        {wdCN.map((w) => <span>{w}</span>)}
      </div>
      <div class="cal-grid">
        {Array.from({ length: firstWeekday }, () => <span class="cal-cell is-blank" aria-hidden="true" />)}
        {calendarDays.map((d) =>
          d.has ? (
            <button type="button" class="cal-cell is-on" data-jump={d.date} data-day={d.date} aria-label={`跳到 ${d.date}`}>{d.day}</button>
          ) : (
            <span class="cal-cell is-empty" data-day={d.date} title="这天没有更新">{d.day}</span>
          )
        )}
      </div>
    </nav>
  )}

  <div class="prose zh-body">
    <Content />
  </div>

  <section class="archive">
    <details>
      <summary>
        <span class="arc-title">已归档 · 往期推荐</span>
        {others.length > 0 && <span class="arc-count">{others.length}</span>}
      </summary>
      <ul class="arc-list">
        {!isLatest && <li><a href="/resources/zhihu-daily-picks/">最新一期</a></li>}
        {others.length > 0 ? (
          others.map((m) => (
            <li><a href={`/resources/zhihu-daily-picks/${m.month}/`}>{monthLabel(m.month)}</a></li>
          ))
        ) : (
          <li class="arc-empty">还没有往期，下个月再来看看～</li>
        )}
      </ul>
    </details>
  </section>
</article>

<script>
  // 点日期跳转：只滚动，不改 URL（避免地址栏出现 #2026-11-23 这类锚点）
  document.querySelectorAll('[data-jump]').forEach((el) => {
    el.addEventListener('click', () => {
      const id = el.getAttribute('data-jump');
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // 把「今天」在月历里圈出来（构建时是静态页面，所以放到浏览器端判断）
  const pad = (n) => String(n).padStart(2, '0');
  const now = new Date();
  const todayKey = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  document.querySelectorAll(`.cal-cell[data-day="${todayKey}"]`).forEach((el) => {
    el.classList.add('is-today');
  });
</script>

<style>
  .zhihu { max-width: var(--maxw); }
  .zh-head { margin: 4px 0 22px; }
  .zh-head .kicker {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    text-transform: uppercase;
    margin: 0 0 0.35em;
  }
  .zh-head h1 {
    font-size: clamp(1.9rem, 4.6vw, 2.5rem);
    margin: 0 0 0.3em;
  }
  .zh-head .sub { margin: 0; color: var(--ink-soft); font-size: 0.92rem; }
  .zh-head .sub strong { color: var(--accent); }

  /* 月历：切月份 + 点日期跳转 */
  .cal {
    margin: 0 0 16px;
    padding: 12px 0 14px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .cal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 320px;
    margin: 0 0 8px;
  }
  .cal-title {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--ink);
  }
  .cal-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid transparent;
    font-size: 1.1rem;
    line-height: 1;
    color: var(--accent);
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .cal-nav:hover { border-color: var(--border); background: var(--surface); text-decoration: none; }
  .cal-nav.is-off { color: var(--border); }
  .cal-week,
  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    max-width: 320px;
  }
  .cal-week span {
    text-align: center;
    padding-bottom: 4px;
    font-family: var(--font-serif);
    font-size: 0.72rem;
    color: var(--ink-soft);
  }
  .cal-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    margin: 1px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: none;
    font-family: var(--font-serif);
    font-size: 0.82rem;
    line-height: 1;
    color: var(--ink-soft);
    -webkit-appearance: none;
    appearance: none;
  }
  button.cal-cell {
    cursor: pointer;
    color: var(--ink);
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  button.cal-cell:hover { color: var(--accent); border-color: var(--accent); }
  .cal-cell.is-empty { opacity: 0.3; }        /* 这天没有更新，日期变浅 */
  .cal-cell.is-blank { visibility: hidden; }  /* 月初前的占位 */
  .cal-cell.is-today { border-color: var(--accent); color: var(--accent); }

  /* 已归档按钮（details/summary） */
  .archive { margin: 40px 0 8px; border-top: 1px solid var(--border); padding-top: 24px; }
  .archive details { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); overflow: hidden; }
  .archive summary {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    list-style: none;
    padding: 14px 18px;
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--ink);
    user-select: none;
  }
  .archive summary::-webkit-details-marker { display: none; }
  .archive summary::before {
    content: "▸";
    color: var(--accent);
    font-size: 0.8rem;
    transition: transform 0.2s ease;
  }
  .archive details[open] summary::before { transform: rotate(90deg); }
  .archive summary:hover { color: var(--accent); }
  .arc-count {
    margin-left: auto;
    font-size: 0.78rem;
    color: var(--ink-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 1px 9px;
  }
  .arc-list {
    list-style: none;
    margin: 0;
    padding: 4px 18px 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .arc-list li { margin: 0; }
  .arc-list a {
    display: inline-block;
    padding: 5px 14px;
    font-family: var(--font-serif);
    font-size: 0.9rem;
    color: var(--ink-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .arc-list a:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }
  .arc-empty { color: var(--ink-soft); font-size: 0.88rem; padding: 4px 0; }
</style>
